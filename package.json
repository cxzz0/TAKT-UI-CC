{
  "name": "takt-ui-cc",
  "version": "1.0.0",
  "description": "TAKT-UI-CC: a multi-machine desktop workbench for Claude Code over SSH \u2014 project/session sidebar, persistent tmux terminals, local file preview, Syncthing sync and a reverse-tunnelled local MCP server.",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "start:mcp": "node mcp-server/server.js --http",
    "start:all": "bash scripts/start.sh",
    "stop": "bash scripts/stop.sh",
    "doctor": "bash scripts/doctor.sh",
    "lint": "eslint .",
    "check": "node scripts/check.js",
    "postinstall": "node scripts/postinstall.js",
    "test": "node --test test/*.test.js",
    "test:smoke": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
